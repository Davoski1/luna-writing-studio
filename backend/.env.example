# Luna AI Writing Studio - Azure & OpenRouter secrets
# Copy this to .env and fill in your actual credentials

# Database settings (Azure PostgreSQL or local SQLite)
# DATABASE_URL="postgresql://lunaadmin:<password>@luna-writing-db-53434.postgres.database.azure.com:5432/postgres?sslmode=require"

# Azure Blob Storage Configuration
AZURE_STORAGE_CONNECTION_STRING="DefaultEndpointsProtocol=https;EndpointSuffix=core.windows.net;AccountName=lunawriterstor47878;AccountKey=<key>;BlobEndpoint=https://lunawriterstor47878.blob.core.windows.net/"
AZURE_STORAGE_CONTAINER="novels"

# Azure OpenAI / Cognitive Services (Standard Fallback Engine)
AZURE_OPENAI_ENDPOINT="https://ochogbeolachene-9618-resource.cognitiveservices.azure.com/openai/v1/chat/completions"
AZURE_OPENAI_KEY=""
API_MODEL="gpt-oss-120b"

# Visual OCR Model Settings (Azure Phi-4-Vision Fallback)
OCR_API_ENDPOINT="https://ochogbeolachene-9618-resource.cognitiveservices.azure.com/openai/v1/chat/completions"
OCR_API_KEY=""
OCR_API_MODEL="Phi-4-Vision"

# OpenRouter Configuration (Primary Engine - Optional)
# If provided, the system automatically routes all LLM calls to the elite OpenRouter models:
# - Narrative Chapters -> x-ai/grok-4.3
# - Logic & Planning Outlines -> deepseek/deepseek-r1
# - Vision OCR -> google/gemini-2.5-flash
# If OpenRouter endpoints are congested or down, it cascades automatically to the Azure models above.
OPENROUTER_API_KEY=""
